// The Pico Breadboard Kit, in sysl — one carrier board's pin map, and nothing else.
//
// **This is board glue and it is meant to be.** `sh.sysl.st7796` is a display driver that runs on any
// chip, `sh.sysl.rp2040blocks` drives an RP2040 that knows about no board, and `sh.sysl.pico` is the
// SDK's surface. None of them knows that this particular carrier board puts an LED on GPIO 16 — that
// fact has to live somewhere, and here is where it lives.
//
// **Everything that was general has left.** The SPI bring-up and the GPIO helpers were written here
// and ran here first; they are now `sh.sysl.rp2040blocks`, because a PL022 reset cycle and a divisor
// search are facts about the chip and would have been copied into the next board's program
// unchanged. What stayed is the pin numbers, the three callbacks that name them, and the one thing
// this glass wants that its controller does not.

import sh.sysl.pico.*
import sh.sysl.rp2040blocks.gpio
import sh.sysl.rp2040blocks.spi
import sh.sysl.st7796.{Rotation, clear, fill_rect, init as panel_init, invert, panel, rgb565}
import sysl.time.DurationUnits

// ## The board
//
// From 52Pi's own documentation for EP-0172, which GeeekPi sell as the same board under their own
// name. **The touch controller, the joystick and the RGB LED are named here and not yet driven** —
// `README.md` says what each of them still wants.

const LED_D1: u32   = 16   // the two user LEDs; D3 and D4 are wired to 3V3 and 5V and are not pins
const LED_D2: u32   = 17
const BTN_1: u32    = 15   // the two buttons, which switch to ground
const BTN_2: u32    = 14
const BUZZER: u32   = 13
const RGB: u32      = 12   // one pin for a colour, so this is an addressable LED rather than three

const TFT_CLK: u32  = 2    // the 3.5" 320x480 panel, an ST7796 over SPI0
const TFT_DIN: u32  = 3
const TFT_CS: u32   = 5
const TFT_DC: u32   = 6
const TFT_RST: u32  = 7

const TOUCH_SDA: u32 = 8   // the capacitive touch controller, over I2C0
const TOUCH_SCL: u32 = 9

// The joystick's two axes are ADC0 and ADC1, which are GPIO 26 and 27. They are named as ADC channels
// rather than as pins because that is the half of the pin this board uses.
const JOY_X_CHANNEL: u32 = 0
const JOY_Y_CHANNEL: u32 = 1

// ## The bus
//
// **`clk_peri` is the SDK's**, running at the system clock by the time any of this executes. Nothing
// here configures it and nothing here should: clocks are the board's business and the SDK owns that.
const PERI_HZ: u32 = 125_000_000

// **31.25 MHz is the fast end of what these carrier boards are reliably wired for.** The ST7796 is
// good for rather more and the panel's ribbon is not; a display that comes up speckled rather than
// blank is this number being too high.
const TFT_HZ: u32 = 31_250_000

// The callbacks below cannot capture, so they ask for the block rather than being handed it. It is
// two integers built from constants, so this costs nothing.
private bus() -> spi.Block = spi.spi0()

// ## The panel's three callbacks
//
// **These are `*extern` rather than closures, so they capture nothing.** `sh.sysl.st7796` takes plain
// function pointers on purpose: a `&Fn` is a trait object, and the compiler cannot know whether one
// holds on to the slice it was given, so every parameter array in the driver would be promoted to the
// heap to outlive its frame. On a board with 264 KB that is the wrong trade, and the price is this —
// one display, reached through the module.
//
// **`CS` and `DC` are ordinary GPIOs and not the SPI block's.** The PL022 has a chip-select of its
// own and it is useless here: it drops between frames, and this panel needs one assertion held across
// a command and every parameter that follows it.

// A command byte with `DC` low, then its parameters with `DC` high, inside one assertion of `CS`.
send_cmd(c: u8, params: *u8, n: usize)
    gpio.low(TFT_CS)

    gpio.low(TFT_DC)
    var one: [1]u8 = [0]
    one[0] = c
    spi.send(bus(), one[..])

    // **`drain` before `DC` moves, every time.** An empty FIFO says the block has accepted the byte,
    // not that it has sent it, and raising `DC` early makes the panel read a command as a parameter.
    spi.drain(bus())

    if n > 0
        gpio.high(TFT_DC)
        spi.send(bus(), params[0..<n])
        spi.drain(bus())

    gpio.high(TFT_CS)
end send_cmd

// Pixels are always data, and always follow a window the driver has already set.
send_pixels(data: *u8, n: usize)
    if n == 0 then return

    gpio.low(TFT_CS)
    gpio.high(TFT_DC)
    spi.send(bus(), data[0..<n])
    spi.drain(bus())
    gpio.high(TFT_CS)
end send_pixels

delay_ms(ms: u32) = sleep(int(ms).ms)

// Held down, given the pull-ups these buttons are configured with.
//
// **This board's buttons are to ground**, which is the board rather than the datasheet talking: 52Pi
// give the pin numbers and not the wiring, and what settled it was pressing them. Wired to 3V3 they
// would want `gpio.input_pulldown` and this without its `!`, and would have announced themselves by
// reporting a button held that nobody was touching.
//
// It stays here rather than in `sh.sysl.rp2040blocks` because which way a button switches is a fact
// about a board, and a GPIO package that knew about buttons would be the first crack in the split
// this program exists to keep.
pressed(pin: u32) -> bool = !gpio.read(pin)

// Hold the panel in reset and let it go, which is the one part of bringing it up that the driver
// cannot do — `SWRESET` is a command, and a command needs a controller already listening.
panel_reset()
    gpio.high(TFT_RST)
    delay_ms(10)
    gpio.low(TFT_RST)
    delay_ms(20)
    gpio.high(TFT_RST)
    delay_ms(120)
end panel_reset

// ## The program

@export("main")
boot() -> int =
    // **The answer is not fatal here, unlike in most programs that use this package.** `init` brings
    // up stdio and then the wireless chip, and this board's own parts are on neither.
    val wireless = init()

    wait_for_terminal()
    print("the Pico Breadboard Kit, in sysl")

    if !wireless
        print("no wireless chip — a plain Pico, or the CMake project linked no cyw43 support")

    gpio.output(LED_D1)
    gpio.output(LED_D2)
    gpio.input_pullup(BTN_1)
    gpio.input_pullup(BTN_2)

    gpio.output(TFT_CS)
    gpio.output(TFT_DC)
    gpio.output(TFT_RST)
    gpio.high(TFT_CS)

    gpio.select(TFT_CLK, gpio.SPI)
    gpio.select(TFT_DIN, gpio.SPI)
    spi.up(bus(), PERI_HZ, TFT_HZ)

    panel_reset()

    var display = panel(&send_cmd, &send_pixels, &delay_ms, Rotation.Landscape)
    panel_init(&display)

    // **This panel wants inversion on, and that is a fact about the module rather than about the
    // controller.** The ST7796's init sequence sends neither `INVON` nor `INVOFF`, so the controller
    // is left at its post-reset default — and this glass is wired the other way up, which is common
    // on the IPS panels these carrier boards use. Without it every colour arrives as its complement:
    // red reads cyan, green magenta, blue yellow, and a black background comes up white.
    //
    // **BTN1 toggles it**, so that the claim is settled by pressing a button rather than by a
    // rebuild — which matters because the two builds print the same thing and differ only on the
    // glass.
    var inverted = true
    invert(&display, inverted)

    print(s"panel up — ${display.width} by ${display.height} at ${spi.rate(PERI_HZ, 2, 1)} Hz")
    print("BTN1 toggles inversion — the bars should read red, green, blue on black")

    clear(&display, rgb565(0, 0, 0))

    // Three bars and a white square: enough that a wrong colour order, a wrong rotation and a wrong
    // window all look like different mistakes rather than like each other.
    val third = display.width / 3

    fill_rect(&display, 0, 0, third, 60, rgb565(255, 0, 0))
    fill_rect(&display, third, 0, third, 60, rgb565(0, 255, 0))
    fill_rect(&display, third * 2, 0, third, 60, rgb565(0, 0, 255))
    fill_rect(&display, 20, 100, 80, 80, rgb565(255, 255, 255))

    var last_1 = false
    var last_2 = false
    var on = false

    loop
        on = !on
        gpio.write(LED_D1, on)
        gpio.write(LED_D2, !on)

        val now_1 = pressed(BTN_1)
        val now_2 = pressed(BTN_2)

        if now_1 != last_1
            last_1 = now_1

            if now_1
                inverted = !inverted
                invert(&display, inverted)
                print(if inverted then "inversion on" else "inversion off")

        if now_2 != last_2
            print(if now_2 then "BTN2 down" else "BTN2 up")
            last_2 = now_2

        sleep(50.ms)
end boot
